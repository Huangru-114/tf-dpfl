# ══════════════════════════════════════════════════════════════════════════
# 红线：大产物永不进 git（只在集群）。仓库 > 500 MB / 单文件 > 10 MB 就回来查这里。
# ══════════════════════════════════════════════════════════════════════════

# ── 源参考库：按需 clone，用完即删，同时只留 1~2 个 ──────────────────────
reference/

# ── 模型 checkpoint / 权重：只在集群，git 里只放 manifest ────────────────
*.h5
*.pt
*.pth
*.ckpt
*.pb
*.keras
*.weights
# checkpoint 目录：`.npz` 留集群，**manifest.json 放行进 git**（CLAUDE.md 回程红线：
# 「git 里只放 manifest（method / path / git_commit / step / metrics）」）。
# 注意不能写成 `checkpoints/` —— 目录本身被排除时，里面的文件无法再被 `!` 放回来。
**/checkpoints/*
!**/checkpoints/*.manifest.json
saved_model/

# ── 大张量 / 金标准产物：靠固定种子的脚本重生成，产物不进 git ────────────
*.npy
*.npz
*.tfrecord
!tests/fixtures/*.npz          # 小的、需版本化的测试夹具单独放行（< 1 MB）

# ── 日志与实验追踪：只保留 tail/grep 后的截断版（手动放进 results/）─────
*.log
*.err
*.out
logs/
runs/
wandb/
events.out.tfevents.*

# ── 数据集缓存 ──────────────────────────────────────────────────────────
data/raw/
tensorflow_datasets/
*.tar.gz
*.zip

# ── Python 虚拟环境（绝不进 git：会污染 grep/glob，稀释注意力）─────────
lib/
lib64/
bin/
include/
share/
pyvenv.cfg
.venv/
venv/
env/

# ── Python 常规 ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ipynb_checkpoints/

# ── 矩阵 manifest 是 submit_matrix.sh 的生成物（每格的 metrics.json 要进 git）──
experiments/matrix/manifest.tsv

# ── 临时 ────────────────────────────────────────────────────────────────
scratch/*
!scratch/.gitkeep
.env
.DS_Store

# ── run 产物：generate_report 在 cwd（= fedavg/）里吐的分类报告 ─────────────
# 每跑一次 main.py 就生成 GM/EM/PM 三类共 3+2×n_edges 个 txt，属于「大产物留集群」那一类。
fedavg/report_*.txt
report_*.txt

# ── SLURM 作业输出（sbatch 默认写到提交目录）────────────────────────────────
slurm-*.out
slurm-*.err

# 误提交的 venv（Alvis 集群，repo 根目录）——永不进 git
/bin/
/pyvenv.cfg
/lib/
/lib64
/include/
/share/
